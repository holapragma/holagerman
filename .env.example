# Base de datos Postgres (Supabase).
# Sacá ambas connection strings desde el dashboard de Supabase:
# Project Settings → Database → Connection string.

# Connection pooling (pgbouncer, puerto 6543). La usa la app en runtime
# (src/lib/db.ts) — necesaria en Vercel por el límite de conexiones concurrentes
# de los planes serverless.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa, sin pooler (puerto 5432). La usa Prisma CLI para migraciones
# (prisma migrate dev/deploy, prisma studio) — el pooler en modo transacción no
# soporta los comandos que corren las migraciones.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Autenticación (Supabase Auth).
# Project Settings → API → Project URL / anon public key.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"
