generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id @default(cuid())
  name      String
  company   String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes    Quote[]

  @@map("german_crm_clients")
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  category           String
  price              Float
  stock              Int                 @default(0)
  photoUrl           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  quoteItems         QuoteItem[]
  competitionEntries CompetitionEntry[]
  supplierQuotes     SupplierQuote[]
  marketObservations MarketObservation[]

  @@map("german_crm_products")
}

model Quote {
  id        String      @id @default(cuid())
  number    Int         @default(0) @unique
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  notes     String?
  subtotal  Float
  ivaPct    Float?
  total     Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     QuoteItem[]

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  companyName         String?
  companyLegalName    String?
  companyTaxId        String?
  companyAddress      String?
  companyPhone        String?
  companyEmail        String?
  companyWebsite      String?
  companyConditions   String?
  companyValidityDays Int?
  companyLogoId       String?
  companyLogo         CompanyLogo? @relation("QuoteCompanyLogo", fields: [companyLogoId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("german_crm_quotes")
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name        String
  description String?
  position    Int      @default(0)
  quantity    Int
  unitPrice   Float
  subtotal    Float

  @@index([quoteId])
  @@map("german_crm_quote_items")
}

model CompetitionEntry {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitorPrice Float
  source          String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("german_crm_competition_entries")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  company   String?
  country   String?
  currency  String   @default("USD")
  contact   String?
  email     String?
  phone     String?
  website   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costConfig SupplierCostConfig?
  quotes     SupplierQuote[]

  @@map("german_crm_suppliers")
}

model SupplierCostConfig {
  id                     String   @id @default(cuid())
  supplierId             String   @unique
  supplier               Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  nacionalizacionPct     Float?
  nacionalizacionType    String   @default("PERCENT")
  comisionPct            Float?
  comisionType           String   @default("PERCENT")
  costosFinancierosPct   Float?
  costosFinancierosType  String   @default("PERCENT")
  envio                  Float?
  envioType              String   @default("FIXED")
  seguro                 Float?
  seguroType             String   @default("FIXED")
  otrosGastos            Float?
  otrosGastosType        String   @default("FIXED")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("german_crm_supplier_cost_configs")
}

model SupplierQuote {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierCode String?
  fobCost      Float
  minQuantity  Int?
  currency     String   @default("USD")
  date         DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
  @@map("german_crm_supplier_quotes")
}

model MarketObservation {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  source        String
  store         String?
  url           String?
  observedPrice Float
  currency      String   @default("ARS")
  date          DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@map("german_crm_market_observations")
}

model CostSettings {
  id                   String   @id @default("global")
  nacionalizacionPct   Float?
  comisionPct          Float?
  costosFinancierosPct Float?
  envio                Float?
  seguro               Float?
  otrosGastos          Float?
  updatedAt            DateTime @updatedAt

  @@map("german_crm_cost_settings")
}

model CompanySettings {
  id        String   @id @default("global")
  ivaPct    Float    @default(21)
  updatedAt DateTime @updatedAt

  @@map("german_crm_company_settings")
}

model Company {
  id                String   @id @default(cuid())
  name              String
  legalName         String?
  taxId             String?
  address           String?
  phone             String?
  email             String?
  website           String?
  quoteValidityDays Int      @default(30)
  conditions        String?
  active            Boolean  @default(true)
  isDefault         Boolean  @default(false)
  logoId            String?
  logo              CompanyLogo? @relation("CompanyLogo", fields: [logoId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  quotes            Quote[]

  @@map("german_crm_companies")
}

model CompanyLogo {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  companies Company[] @relation("CompanyLogo")
  quotes    Quote[]   @relation("QuoteCompanyLogo")

  @@map("german_crm_company_logos")
}
